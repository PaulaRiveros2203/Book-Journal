# ============================================================
# Book-Journal - Variables de entorno
# ============================================================
# Copia este archivo y renómbralo como .env
# NUNCA subas el archivo .env real al repositorio

# Configuración de la base de datos PostgreSQL (Google Cloud SQL)
DB_HOST=34.66.88.86
DB_PORT=5432
DB_NAME=libreria_online
DB_USERNAME=bookjournal
DB_PASSWORD=tu_contraseña_aqui

# Configuración para Spring Boot (application.properties)
spring.datasource.url=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
